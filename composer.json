{
    "name": "konekt/spoke",
    "description": "Spoke — developer dashboard for Laravel: Flight Recorder, logs, SQL, Redis, queue history, scheduler, emails & server metrics.",
    "type": "library",
    "license": "proprietary",
    "homepage": "https://github.com/spok-sto/spoke",
    "version": "1.1.0",
    "keywords": ["laravel", "debug", "logs", "monitoring", "dev-tools"],
    "authors": [
        {
            "name": "Srđan Stojković",
            "email": "spok@konekt.rs",
            "role": "Author & Developer"
        },
        {
            "name": "Srdjan Stojkovich",
            "homepage": "https://github.com/spok-sto/spoke",
            "role": "Owner"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-mbstring": "*",
        "laravel/framework": "^9.52.20|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "orchestra/testbench": "^7.24|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5.10|^10.5|^11.0|^12.0",
        "guzzlehttp/guzzle": "^7.5|^8.0",
        "phpstan/phpstan": "^1.11",
        "laravel/pint": "^1.13"
    },
    "autoload": {
        "psr-4": {
            "Konekt\\Spoke\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Konekt\\Spoke\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --no-progress --memory-limit=512M",
        "format": "pint",
        "format:test": "pint --test"
    },
    "extra": {
        "laravel": {
            "providers": [
                "Konekt\\Spoke\\SpokeServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
